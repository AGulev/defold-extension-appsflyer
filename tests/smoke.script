-- See tests/README.md for building and injecting local test credentials.
local function callback(self, message_id, message)
    assert(self.start_requested, "SDK sent a callback before Lua requested start")
    local names = {
        [appsflyer.CONVERSION_DATA_SUCCESS] = "CONVERSION_DATA_SUCCESS",
        [appsflyer.CONVERSION_DATA_FAIL] = "CONVERSION_DATA_FAIL",
        [appsflyer.START_SUCCESS] = "START_SUCCESS",
        [appsflyer.START_FAIL] = "START_FAIL",
        [appsflyer.EVENT_SUCCESS] = "EVENT_SUCCESS",
        [appsflyer.EVENT_FAIL] = "EVENT_FAIL",
    }
    print("AF_SMOKE", names[message_id], json.encode(message))
    if message_id == appsflyer.EVENT_FAIL and message.event_name == "defold_sdk_stopped" then
        assert(not self.stopped_event_rejected, "Duplicate stopped-event result")
        self.stopped_event_rejected = true
        print("AF_SMOKE STOPPED_EVENT_PASS")
    end
    if message_id == appsflyer.START_SUCCESS or message_id == appsflyer.START_FAIL then
        self.starts = self.starts + 1
        if not self.stop_test_started then
            assert(self.starts == 1, "Duplicate session before stop/resume")
        end
        if not self.event_sent then
            appsflyer.set_callback(nil)
            appsflyer.set_callback(callback)
            print("AF_SMOKE CALLBACK_REPLACEMENT_PASS")
            self.event_sent = true
            appsflyer.log_event("defold_sdk_smoke", { one = "one", two = 2 })
            local uid = appsflyer.get_appsflyer_uid()
            assert(type(uid) == "string" and #uid > 0, "AppsFlyer UID missing")
            assert(uid == appsflyer.get_appsflyer_uid(), "AppsFlyer UID changed")
            print("AF_SMOKE UID_OK")
        end
    end
    if message_id == appsflyer.START_SUCCESS then self.start_ok = true end
    if message_id == appsflyer.EVENT_SUCCESS then
        assert(message.event_name == "defold_sdk_smoke")
        self.event_ok = true
    end
    if self.start_ok and self.event_ok and not self.passed then
        self.passed = true
        print("AF_SMOKE DELIVERY_PASS")
    end
end

function init(self)
    assert(appsflyer, "AppsFlyer module missing")
    local version = appsflyer.get_sdk_version()
    local expected = sys.get_sys_info().system_name == "iPhone OS" and "7.0.2" or "7.0.1"
    assert(version:find(expected, 1, true), "Unexpected SDK version: " .. version)
    print("AF_SMOKE SDK_VERSION", version)
    self.starts = 0
    self.start_requested = false
    appsflyer.set_debug_log(true)
    appsflyer.set_callback(function() error("Replaced callback invoked") end)
    appsflyer.set_callback(nil)
    appsflyer.set_callback(callback)
    appsflyer.set_customer_user_id("defold_sdk7_smoke")
    assert(not pcall(appsflyer.set_consent_data, true))
    assert(not pcall(appsflyer.set_consent_data, { has_consent_for_data_usage = "false" }))
    assert(not pcall(appsflyer.set_consent_data, { has_consent_for_data_usag = false }))
    assert(not pcall(appsflyer.set_sharing_filter_for_partners, "all"))
    assert(not pcall(appsflyer.set_sharing_filter_for_partners, { [2] = "all" }))
    assert(not pcall(appsflyer.set_sharing_filter_for_partners, { partner = "all" }))
    assert(not pcall(appsflyer.set_sharing_filter_for_partners, { "invalid-partner" }))
    assert(not pcall(appsflyer.set_sharing_filter_for_partners, { 123 }))
    assert(not pcall(appsflyer.set_currency_code, "usd"))
    assert(not pcall(appsflyer.set_currency_code, "US"))
    assert(not pcall(appsflyer.anonymize_user, "false"))
    assert(not pcall(appsflyer.enable_tcf_data_collection, 1))
    assert(not pcall(appsflyer.stop_sdk, nil))
    print("AF_SMOKE NEW_API_VALIDATION_PASS")
    if sys.get_config_string("appsflyer.key", "") == "" then
        assert(not pcall(appsflyer.start_sdk), "Missing credentials should reject start")
        print("AF_SMOKE MISSING_KEY_PASS")
        return
    end
    assert(not pcall(appsflyer.log_event, "invalid", { [1] = "bad key" }))
    assert(not pcall(appsflyer.log_event, "invalid", { nested = {} }))
    assert(not pcall(appsflyer.log_event, "invalid", true))
    print("AF_SMOKE INPUT_VALIDATION_PASS")
    appsflyer.enable_tcf_data_collection(true)
    appsflyer.enable_tcf_data_collection(false)
    appsflyer.set_consent_data({}) -- All four signals remain unspecified.
    appsflyer.set_consent_data({ is_user_subject_to_gdpr = false })
    -- Synthetic choices for this test app only; real apps use the user's choices.
    appsflyer.set_consent_data({
        is_user_subject_to_gdpr = true,
        has_consent_for_data_usage = true,
        has_consent_for_ads_personalization = false,
        -- Deliberately omit ad-storage consent to verify nil survives the bridge.
    })
    appsflyer.anonymize_user(true)
    appsflyer.anonymize_user(false)
    appsflyer.set_currency_code("EUR")
    appsflyer.set_sharing_filter_for_partners({ "examplePartner1_int", "examplePartner2_int" })
    appsflyer.set_sharing_filter_for_partners({})
    appsflyer.set_sharing_filter_for_partners({ "all" })
    appsflyer.stop_sdk(true)
    appsflyer.start_sdk() -- Stopped SDK must not deliver a session.
    timer.delay(1, false, function()
        assert(appsflyer.is_stopped(), "Native SDK did not stop")
        assert(self.starts == 0, "Stopped SDK started a session")
        appsflyer.stop_sdk(true) -- Revoke the pending start request.
        appsflyer.stop_sdk(false)
    end)
    timer.delay(3, false, function()
        assert(not appsflyer.is_stopped(), "Native SDK did not resume")
        assert(self.starts == 0, "SDK started before Lua's start gate")
        print("AF_SMOKE NEW_API_CONFIG_PASS")
        print("AF_SMOKE START_REQUESTED")
        self.start_requested = true
        appsflyer.start_sdk()
        appsflyer.start_sdk() -- Must not duplicate the session in this foreground cycle.
    end)
    timer.delay(12, false, function()
        self.stop_test_started = true
        appsflyer.stop_sdk(true)
    end)
    timer.delay(13, false, function()
        assert(appsflyer.is_stopped(), "Native SDK did not stop after delivery")
        appsflyer.log_event("defold_sdk_stopped")
    end)
    timer.delay(16, false, function()
        assert(self.stopped_event_rejected, "Stopped event was not rejected")
        appsflyer.stop_sdk(false)
        appsflyer.start_sdk()
        print("AF_SMOKE STOP_RESUME_PASS")
    end)
    timer.delay(40, false, function()
        print("AF_SMOKE RESULT", self.passed and self.stopped_event_rejected and "PASS" or "FAIL", "session_callbacks", self.starts)
    end)
end

function final(self)
    if appsflyer then appsflyer.set_callback(nil) end
end
